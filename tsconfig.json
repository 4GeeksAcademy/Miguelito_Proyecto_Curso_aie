{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "packages/shared/**/*.ts",
    "uis/backoffice/app/**/*.ts",
    "uis/backoffice/app/**/*.tsx",
    "uis/backoffice/next.config.ts"
  ]
}